/* Estilos compartidos por las páginas de proyectos */
:root {
  --navy: #0d253f;
  --navy-2: #0a3d62;
  --azul: #2b6cb0;
  --acento: #e67e22;
  --rosa: #c2185b;
  --fondo: #f6f8fb;
  --card: #ffffff;
  --texto: #1d2b3a;
  --suave: #5b6b7d;
  --borde: #e3e9f1;
  --ok: #2f855a;
  --radio: 14px;
  --sombra: 0 6px 24px rgba(13, 37, 63, 0.07);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Poppins', system-ui, sans-serif;
  background: var(--fondo);
  color: var(--texto);
  line-height: 1.65;
  font-size: 16px;
}
a { color: var(--azul); }
img { max-width: 100%; }

/* Barra superior */
.topbar {
  position: sticky; top: 0; z-index: 50;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--borde);
}
.topbar .wrap { display: flex; align-items: center; justify-content: space-between; height: 60px; gap: 1rem; }
.topbar a { text-decoration: none; color: var(--navy); font-weight: 500; font-size: 0.95rem; }
.topbar .marca { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.1rem; }

.wrap { max-width: 1100px; margin: 0 auto; padding: 0 20px; }

/* Encabezado */
.cabecera {
  background: linear-gradient(135deg, #0a3d62 0%, #3c6382 100%);
  color: #fff;
  padding: 56px 0 48px;
}
.cabecera .categoria {
  display: inline-block; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase;
  background: rgba(255,255,255,0.15); padding: 4px 12px; border-radius: 8px; margin-bottom: 14px;
}
.cabecera h1 { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem, 4.5vw, 2.9rem); line-height: 1.15; margin-bottom: 14px; }
.cabecera p.bajada { max-width: 760px; font-size: 1.08rem; opacity: 0.92; }
.etiquetas { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
.etiquetas span { background: #fff; color: var(--navy-2); font-size: 0.8rem; font-weight: 600; padding: 4px 12px; border-radius: 999px; }
.botones { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
.btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: 0.92rem;
  text-decoration: none; border: 2px solid #fff; color: #fff; transition: all 0.2s;
}
.btn:hover { background: #fff; color: var(--navy-2); }
.btn.lleno { background: var(--acento); border-color: var(--acento); }
.btn.lleno:hover { background: #cf6d17; border-color: #cf6d17; color: #fff; }

/* Secciones */
section { padding: 48px 0 8px; }
h2 { font-family: 'Playfair Display', serif; font-size: 1.75rem; color: var(--navy); margin-bottom: 10px; }
h3 { font-size: 1.08rem; color: var(--navy); margin-bottom: 8px; }
.intro { color: var(--suave); max-width: 780px; margin-bottom: 22px; }

.card { background: var(--card); border: 1px solid var(--borde); border-radius: var(--radio); box-shadow: var(--sombra); padding: 22px; }
.grid { display: grid; gap: 18px; }
.g2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.g3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.g4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.g5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
@media (max-width: 900px) { .g4, .g5 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .g3 { grid-template-columns: 1fr; } }
@media (max-width: 680px) { .g2 { grid-template-columns: 1fr; } }

/* KPIs */
.kpi { text-align: left; }
.kpi .valor { font-size: 1.7rem; font-weight: 700; color: var(--navy-2); line-height: 1.2; font-variant-numeric: tabular-nums; }
.kpi .nombre { color: var(--suave); font-size: 0.86rem; margin-top: 4px; }

/* Pasos del proceso */
.paso .num { width: 34px; height: 34px; border-radius: 50%; background: var(--navy-2); color: #fff; display: grid; place-items: center; font-weight: 700; margin-bottom: 10px; }
.paso p { color: var(--suave); font-size: 0.92rem; }
.paso .herr { margin-top: 10px; font-size: 0.8rem; font-weight: 600; color: var(--acento); }

/* Gráficos */
.grafico { position: relative; height: 320px; }
.grafico.alto { height: 380px; }
.controles { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 14px; }
select, .chip {
  font-family: inherit; font-size: 0.9rem; padding: 8px 12px; border-radius: 10px;
  border: 1px solid var(--borde); background: #fff; color: var(--texto);
}
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { cursor: pointer; transition: all 0.15s; }
.chip.activo { background: var(--navy-2); color: #fff; border-color: var(--navy-2); }
.nota { font-size: 0.85rem; color: var(--suave); margin-top: 12px; }

/* Lectura / insights */
.insight { border-left: 4px solid var(--acento); background: #fff8f1; padding: 14px 18px; border-radius: 0 10px 10px 0; margin-top: 16px; font-size: 0.95rem; }
.insight strong { color: var(--navy); }
ul.lista { padding-left: 1.2rem; }
ul.lista li { margin-bottom: 8px; }

/* Tablas */
.tabla-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
th, td { padding: 10px 12px; border-bottom: 1px solid var(--borde); text-align: right; }
th:first-child, td:first-child { text-align: left; }
th { color: var(--suave); font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.03em; }
tr.destacada td { font-weight: 600; color: var(--navy-2); }

/* Pie */
footer { margin-top: 56px; padding: 28px 0; background: var(--navy); color: rgba(255,255,255,0.8); font-size: 0.9rem; }
footer a { color: #fff; }
footer .wrap { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
